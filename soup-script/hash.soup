(define (make-table)
  (list '*table*))

(define (lookup key table)
  (let ((record (assoc key (cdr table))))
    (if record
        (cdr record)
        false)))

(define (insert! key value table)
  (let ((record (assoc key (cdr table))))
    (if record
        (set-cdr! record value)
        (set-cdr! table
                  (cons (cons key value)
                        (cdr table)))))
  'ok)

(define h1 (make-table))

(insert! (list 'foo 'bar) 'bar h1)
(insert! (list 'foo 'baz) 'baz h1)

(lookup (list 'foo 'bar) h1)
h1